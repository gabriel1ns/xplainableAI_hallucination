    <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/gabriel/ontologies/alucinacao_ia#ConceituoIA"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/gabriel/ontologies/alucinacao_ia#operaCom">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="pt">operaCom</rdfs:label>
    <rdfs:comment xml:lang="pt">Sistema opera com um conceito</rdfs:comment>
    <rdfs:domain rdf:resource="http://www.semanticweb.org/gabriel/ontologies/alucinacao_ia#SistemaIA"/>
    <rdfs:range rdf:resource="http://www.semanticweb.org/gabriel/ontologies/alucinacao_ia#ConceituoIA"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/gabriel/ontologies/alucinacao_ia#Gemini">
