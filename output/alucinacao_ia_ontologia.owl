  <rdf:Description rdf:about="http://www.semanticweb.org/gabriel/ontologies/alucinacao_ia#permite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="pt">permite</rdfs:label>
    <rdfs:comment xml:lang="pt">Camada semântica permite inferências</rdfs:comment>
    <rdfs:domain rdf:resource="http://www.semanticweb.org/gabriel/ontologies/alucinacao_ia#CamadaSemantica"/>
    <rdfs:range rdf:resource="http://www.semanticweb.org/gabriel/ontologies/alucinacao_ia#ConceituoIA"/>
  </rdf:Description>
